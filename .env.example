# ============================================================
# CATATAN KONFIGURASI:
# ============================================================
# 
# 1. GAS_DEPLOYMENT_ID
#    - Ambil dari URL Web App Apps Script
#    - Format: https://script.google.com/macros/d/{ID}/usercontent
#    - Contoh: 1ABC123DEF456
#
# 2. SPREADSHEET_ID
#    - Ambil dari URL Google Sheets
#    - Format: https://docs.google.com/spreadsheets/d/{ID}/edit
#    - Contoh: 11q7bt212H_-l-CcklK-yygeigMQH8l-CBGihT1BGKHk
#
# 3. ADMIN_PASSWORD
#    - Digunakan untuk login ke Admin Panel
#    - Ganti dengan password yang kuat dan mudah diingat
#    - Minimal 8 karakter, hindari karakter spesial
#
# 4. EVENT_STATUS
#    - AKTIF: Sistem presensi sedang berjalan
#    - ARSIP: Presensi sudah ditutup, hanya bisa lihat laporan
#
# ============================================================

# Opsional: Cloud Storage (jika ingin backup ke cloud)
CLOUD_BACKUP_ENABLED=false
BACKUP_FREQUENCY=daily

# Opsional: Logging
LOG_LEVEL=info
LOG_FILE=attendance.log

# Opsional: Security
CORS_ENABLED=true
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=60
